end

task.spawn(function()
	while alive() do
		if state.autoScanUnits and os.clock() >= autoScanNextAt then
			autoScanNextAt = os.clock() + AUTO_SCAN_INTERVAL
			local ok, count = pcall(scanUnitIds, false)
			if ok and count > 0 then
				print(("[Nemohub] Auto Scan Units: found %d new ID(s)"):format(count))
			elseif not ok then
				warn("[Nemohub] Auto Scan Units failed: " .. tostring(count))
			end
		end
		task.wait(1)
	end
end)

task.spawn(function()
	task.wait(1)
	if not alive() then return end
	scanUnitIds(true)
end)

local clearQueueFn = clear_queue_on_teleport or clearqueueonteleport or (syn and syn.clear_queue_on_teleport)

local function queueSelf()
	if state.autoExecTeleport and type(queueFn) == "function" then
		local ok, err = pcall(queueFn, buildQueuedCode())
		if not ok then
			warn("[Nemohub] Could not queue teleport script: " .. tostring(err))
		end
	end
end

local function setAutoExecTeleport(v)
	if v then queueSelf() elseif type(clearQueueFn) == "function" then pcall(clearQueueFn) end
end

