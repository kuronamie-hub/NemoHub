local function drawAnimeIcon(parentObj, kind, x, y, pixelSize, tint)
	local holder = Instance.new("Frame")
	holder.Name = "VectorIcon"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Position = UDim2.fromOffset(x, y)
	holder.Size = UDim2.fromOffset(pixelSize, pixelSize)
	holder.Parent = parentObj
	local u = pixelSize / 24

	local function bar(cx, cy, w, h, rotation, rounded)
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromOffset(cx * u, cy * u)
		f.Size = UDim2.fromOffset(math.max(w * u, 1), math.max(h * u, 1))
		f.Rotation = rotation or 0
		f.BorderSizePixel = 0
		f.BackgroundColor3 = tint
		f.Parent = holder
		if rounded then
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, math.max(1, rounded * u))
			c.Parent = f
		end
		return f
	end

	if kind == "main" then
		bar(7, 8, 12, 2.4, -44, 1)
		bar(17, 8, 12, 2.4, 44, 1)
		bar(5.2, 15, 2.4, 10, 0, 1)
		bar(18.8, 15, 2.4, 10, 0, 1)
		bar(12, 19.4, 15, 2.4, 0, 1)
		bar(12, 16, 4, 8, 0, 1)
	elseif kind == "fishing" then
		bar(12, 12, 14, 2, 0, 1)
		bar(6, 12, 2, 6, 0, 1)
		bar(18, 12, 2, 6, 0, 1)
		bar(6, 15, 2, 2, 45, 1)
		bar(18, 15, 2, 2, -45, 1)
	elseif kind == "teleport" then
		bar(12, 12, 16, 2, 0, 1)
		bar(12, 12, 2, 16, 0, 1)
		bar(12, 12, 8, 2, 45, 1)
		bar(12, 12, 8, 2, -45, 1)
	elseif kind == "player" then
		bar(12, 7.1, 10, 10, 0, 8)
		bar(12, 19, 18, 8, 0, 6)
	elseif kind == "settings" then
		bar(12, 5, 20, 2, 0, 1)
		bar(12, 12, 20, 2, 0, 1)
		bar(12, 19, 20, 2, 0, 1)
		bar(8, 5, 5, 6, 0, 2)
		bar(16, 12, 5, 6, 0, 2)
		bar(10, 19, 5, 6, 0, 2)
	else
