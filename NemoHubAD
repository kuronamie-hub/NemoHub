-- Auto Join Event
task.spawn(function()
	local requested = false
	local busy = false
	local retryAt = 0
	local lastInfo = 0
	local attempts = 0
	local wasEnabled = false

	while alive() do
		local enabled = state.autoJoinEvent and not (state.autoJoinDailyChallenge and dailyChallenge.canJoin())
		if not enabled then
			requested = false
			busy = false
			retryAt = 0
			attempts = 0
		elseif not wasEnabled then
			requested = false
			retryAt = 0
			attempts = 0
		end
		wasEnabled = enabled

		if enabled and not matchEnding and not requested and not busy and os.clock() >= retryAt and attempts < 3 then
			requested = true
			busy = true
			attempts = attempts + 1

			task.spawn(function()
				local ep = ReplicatedStorage:FindFirstChild("endpoints")
				local folder = ep and ep:FindFirstChild("client_to_server")
				local remote = folder and folder:FindFirstChild("request_matchmaking")
				local ok, reply = false, "request_matchmaking missing"
				if remote and remote:IsA("RemoteFunction") then
					ok, reply = pcall(function() return remote:InvokeServer("summer2_event") end)
				end
				if not alive() or not state.autoJoinEvent then return end
				busy = false
				if not ok or reply == false then
					requested = false
					retryAt = os.clock() + 20
				end
			end)
		end
		task.wait(1)
	end
end)

-- Daily Challenge
local function runDailyChallengeJoin()
	local requested = false
	while alive() do
		if not state.autoJoinDailyChallenge then
			requested = false
		elseif not dailyChallenge.canJoin() then
			requested = false
		elseif not requested and not matchEnding then
			requested = true
			local ok, result = invokeRet("request_matchmaking", "__DAILY_CHALLENGE")
			if not ok or result == false then
				-- Failed
			else
				dailyChallenge.requested()
			end
		end
		task.wait(1)
	end
end
task.spawn(runDailyChallengeJoin)

