local UUID_PATTERN = "^{%x+%-%x+%-%x+%-%x+%-%x+}$"
local lastScan = 0

local function addUnitId(id, confirmed, likely)
	if type(id) ~= "string" or not id:match(UUID_PATTERN) then return false end
	if confirmed then learned.confirmed[id] = true end
	if likely then learned.likely[id] = true end
	if not learned.ids[id] then
		learned.ids[id] = true
		learned.count = learned.count + 1
		return true
	end
	return false
end

local function scanInstanceTree(root, likely)
	if not root then return end
	local n = 0
	for _, inst in ipairs(root:GetDescendants()) do
		n = n + 1
		if n % 400 == 0 then
			task.wait()
			if not alive() then return end
		end
		addUnitId(inst.Name, false, likely)
		if inst:IsA("StringValue") then addUnitId(inst.Value, false, likely) end
		if inst:IsA("LuaSourceContainer") then
			local okSrc, source = pcall(function() return inst.Source end)
			if okSrc and type(source) == "string" and #source > 0 then
				for id in source:gmatch("{%x+%-%x+%-%x+%-%x+%-%x+}") do addUnitId(id, false, likely) end
			end
		end
		for _, v in pairs(inst:GetAttributes()) do addUnitId(v, false, likely) end
	end
end

local scanning = false
local function scanUnitIds(full)
	if scanning then return 0 end
	scanning = true
	lastScan = os.clock()
	local before = learned.count
	pcall(function()
		scanInstanceTree(Players.LocalPlayer, true)
		if full ~= false then scanInstanceTree(ReplicatedStorage, false) end
		local unitsFolder = workspace:FindFirstChild("_UNITS")
		if unitsFolder then scanInstanceTree(unitsFolder, false) end
		for _, inst in ipairs(workspace:GetChildren()) do
			local name = inst.Name:lower()
			if name:find("unit") or name:find("place") or name:find("tower") or name:find("base") or name:find("plot") then
				scanInstanceTree(inst, false)
			end
		end
	end)
	scanning = false
	return learned.count - before
end

local AUTO_SCAN_INTERVAL = 20
local autoScanNextAt = 0
local function requestAutoScan()
