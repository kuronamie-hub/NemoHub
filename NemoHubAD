local SCRIPT_BUILD = "Nemohub-V1.0"
local SCRIPT_URL = ""
local SCRIPT_FILE = "nemohub.lua"
local SCRIPT_FILE_NAMES = {
	"nemohub.lua",
	"Nemohub.lua",
	"nemohub.luau",
	"nemohub.txt",
	"nemohub.lua.txt",
}

local queueFn = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)

local function readOwnFile()
	if not (isfile and readfile) then return nil end
	local firstOld
	for _, name in ipairs(SCRIPT_FILE_NAMES) do
		local okR, content = pcall(function()
			if isfile(name) then
				return readfile(name)
			end
		end)
		if okR and type(content) == "string" and #content > 0 then
			if content:find(SCRIPT_BUILD, 1, true) then
				return content, name, true
			end
			firstOld = firstOld or { content, name }
		end
	end
	if firstOld then
		return firstOld[1], firstOld[2], false
	end
	return nil
end

if SCRIPT_URL == "" and not readOwnFile() then
	warn("[Nemohub] Auto execute needs SCRIPT_URL filled in or the file '" .. SCRIPT_FILE .. "' saved in your executor's workspace folder.")
end

local function buildQueuedCode()
	local parts = {
		"repeat task.wait() until game:IsLoaded()",
		"task.wait(5)",
		"local env = (type(getgenv) == 'function' and getgenv()) or _G",
		"env.NemohubFromQueue = true",
		[[local function runSource(source, label)
            if type(source) ~= "string" or source == "" then return false, label .. ": empty response" end
            if type(loadstring) ~= "function" then return false, "loadstring unavailable in executor" end
            local chunk, compileError = loadstring(source)
            if type(chunk) ~= "function" then return false, label .. " compile: " .. tostring(compileError) end
            local ok, err = pcall(chunk)
            if not ok then return false, label .. " runtime: " .. tostring(err) end
            return true
        end]],
		"local ok, err = false, 'no script source available'",
	}
	if SCRIPT_URL ~= "" then
		parts[#parts + 1] = ("local fetched, result = pcall(function() return game:HttpGet(%q) end); if fetched then ok, err = runSource(result, 'URL') else err = 'download: ' .. tostring(result) end"):format(SCRIPT_URL)
	end
	local quotedNames = {}
	for _, n in ipairs(SCRIPT_FILE_NAMES) do
		quotedNames[#quotedNames + 1] = ("%q"):format(n)
	end
	parts[#parts + 1] = ("if not ok and type(isfile) == 'function' and type(readfile) == 'function' then for _, n in ipairs({%s}) do local exists, has = pcall(isfile, n); if exists and has then local readOk, content = pcall(readfile, n); if readOk then ok, err = runSource(content, n); if ok then break end end end end end"):format(table.concat(quotedNames, ","))
	parts[#parts + 1] = 'if not ok then env.NemohubFromQueue = nil; warn("[Nemohub] auto execute failed: " .. tostring(err)) end'
	return table.concat(parts, "\n")
end

