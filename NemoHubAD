local function b64decode(data)
	local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local lookup = {}
	for i = 1, #chars do lookup[chars:sub(i, i)] = i - 1 end
	data = data:gsub("[^%w%+/=]", "")
	local out = {}
	local buf, bits = 0, 0
	for i = 1, #data do
		local c = data:sub(i, i)
		if c == "=" then break end
		buf = buf * 64 + lookup[c]
		bits = bits + 6
		if bits >= 8 then
			bits = bits - 8
			local byte = math.floor(buf / 2 ^ bits)
			out[#out + 1] = string.char(byte % 256)
			buf = buf % 2 ^ bits
		end
	end
	return table.concat(out)
end

local function loadImageAsset(b64, fileName)
	if b64 == "" or type(writefile) ~= "function" then return nil end
	local getAsset = getcustomasset or getsynasset
	if type(getAsset) ~= "function" then return nil end
	local ok, asset = pcall(function()
		writefile(fileName, b64decode(b64))
		return getAsset(fileName)
	end)
	if ok then return asset end
	return nil
end

